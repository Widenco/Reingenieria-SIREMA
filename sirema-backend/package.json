{
  "name": "sirema-backend",
  "version": "0.1.0",
  "description": "API REST de SIREMA - reingenieria con RBAC",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "migrate": "knex migrate:latest",
