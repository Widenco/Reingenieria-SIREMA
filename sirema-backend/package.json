    "seed": "knex seed:run",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "knex": "^3.1.0",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
